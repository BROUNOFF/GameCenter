dth="300.0" height="1338.0" as="geometry"/></mxCell><mxCell id="v7" value="Администратор" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="920.0" y="20.0" width="300.0" height="32.0" as="geometry"/></mxCell><mxCell id="v8" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="920.0" y="52.0" width="300.0" height="1338.0" as="geometry"/></mxCell><mxCell id="v9" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="157.0" y="99.0" width="26.0" height="26.0" as="geometry"/></mxCell><mxCell id="v10" value="Оформить онлайн-заявку на сайте или в мессенджере" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="52.0" y="163.0" width="236.0" height="46.0" as="geometry"/></mxCell><mxCell id="v11" value="Создать сделку; робот отправляет JSON-пакет POST /hs/bitrix/booking" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="352.0" y="237.0" width="236.0" height="46.0" as="geometry"/></mxCell><mxCell id="v12" value="Проверить токен (SHA-256) и разобрать JSON-пакет" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="652.0" y="311.0" width="236.0" height="46.0" as="geometry"/></mxCell><mxCell id="v13" value="Токен и пакет корректны?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="665.0" y="376.0" width="210.0" height="64.0" as="geometry"/></mxCell><mxCell id="v14" value="Получить ответ 401 / 400, отметить ошибку обмена" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="355.0" y="385.0" width="230.0" height="46.0" as="geometry"/></mxCell><mxCell id="v15" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="456.0" y="468.0" width="28.0" height="28.0" as="geometry"/></mxCell><mxCell id="v16" value="Сделка уже обработана?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="665.0" y="450.0" width="210.0" height="64.0" as="geometry"/></mxCell><mxCell id="v17" value="Вернуть сохранённый результат без дубля (200)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="955.0" y="459.0" width="230.0" height="46.0" as="geometry"/></mxCell><mxCell id="v18" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1056.0" y="542.0" width="28.0" height="28.0" as="geometry"/></mxCell><mxCell id="v19" value="Найти клиента по телефону или создать, записать бронь «Новая»" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="652.0" y="533.0" width="236.0" height="46.0" as="geometry"/></mxCell><mxCell id="v20" value="Заблокировать ГрафикЗанятости зала, найти ПК без пересечений интервала" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="652.0" y="607.0" width="236.0" height="46.0" as="geometry"/></mxCell><mxCell id="v21" value="Свободный ПК найден?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="665.0" y="672.0" width="210.0" height="64.0" as="geometry"/></mxCell><mxCell id="v22" value="Провести бронь «Подтверждена», ответ 201" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="645.0" y="755.0" width="230.0" height="46.0" as="geometry"/></mxCell><mxCell id="v23" value="Записать «Отказ: нет мест», событие в журнал, ответ 409" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="950.0" y="755.0" width="240.0" height="46.0" as="geometry"/></mxCell><mxCell id="v24" value="Поставить в очередь crm.deal.update и запустить отправку" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="640.0" y="829.0" width="240.0" height="46.0" as="geometry"/></mxCell><mxCell id="v25" value="Битрикс24 ответил?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="670.0" y="894.0" width="200.0" height="64.0" as="geometry"/></mxCell><mxCell id="v26" value="Оставить сообщение в очереди: повтор каждые 60 с, не более 5 попыток" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="945.0" y="903.0" width="250.0" height="46.0" as="geometry"/></mxCell><mxCell id="v27" value="Обновить стадию сделки и уведомить клиента" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="352.0" y="977.0" width="236.0" height="46.0" as="geometry"/></mxCell><mxCell id="v28" value="Получить подтверждение или отказ" style="rounded=1;arcSize=30;w