teSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="600.0" y="20.0" width="290.0" height="32.0" as="geometry"/></mxCell><mxCell id="v6" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="600.0" y="52.0" width="290.0" height="1116.0" as="geometry"/></mxCell><mxCell id="v7" value="ККТ, Битрикс24" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;fontStyle=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="890.0" y="20.0" width="290.0" height="32.0" as="geometry"/></mxCell><mxCell id="v8" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="890.0" y="52.0" width="290.0" height="1116.0" as="geometry"/></mxCell><mxCell id="v9" value="" style="ellipse;fillColor=#000000;strokeColor=#000000;html=1;" vertex="1" parent="1"><mxGeometry x="152.0" y="99.0" width="26.0" height="26.0" as="geometry"/></mxCell><mxCell id="v10" value="Нажать «Закрыть смену» в подсистеме «Касса»" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="47.0" y="163.0" width="236.0" height="46.0" as="geometry"/></mxCell><mxCell id="v11" value="Найти непроведённые чеки и активные («зависшие») сессии смены" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="627.0" y="237.0" width="236.0" height="46.0" as="geometry"/></mxCell><mxCell id="v12" value="Есть незавершённые операции?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="345.0" y="302.0" width="220.0" height="64.0" as="geometry"/></mxCell><mxCell id="v13" value="Провести или отменить чеки, передать активные сессии следующей смене" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="35.0" y="311.0" width="260.0" height="46.0" as="geometry"/></mxCell><mxCell id="v14" value="Сформировать Z-отчёт по оборотам регистра «Выручка»" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="627.0" y="385.0" width="236.0" height="46.0" as="geometry"/></mxCell><mxCell id="v15" value="Показать выручку: наличные и безналичные, сеансы ПК, бар, прокат" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="337.0" y="459.0" width="236.0" height="46.0" as="geometry"/></mxCell><mxCell id="v16" value="Пересчитать наличные, ввести фактическую сумму, подтвердить" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="47.0" y="533.0" width="236.0" height="46.0" as="geometry"/></mxCell><mxCell id="v17" value="Провести «Отчёт о розничных продажах», закрыть смену" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="627.0" y="607.0" width="236.0" height="46.0" as="geometry"/></mxCell><mxCell id="v18" value="Есть расхождение наличных?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="635.0" y="672.0" width="220.0" height="64.0" as="geometry"/></mxCell><mxCell id="v19" value="Провести «Акт расхождения», записать событие" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="615.0" y="755.0" width="240.0" height="46.0" as="geometry"/></mxCell><mxCell id="v20" value="Битрикс24: задача руководителю о расхождении" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="915.0" y="755.0" width="240.0" height="46.0" as="geometry"/></mxCell><mxCell id="v21" value="ККТ: отчёт о закрытии смены" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="925.0" y="829.0" width="220.0" height="46.0" as="geometry"/></mxCell><mxCell id="v22" value="Заблокировать ввод в документах смены, показать окно завершения" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="337.0" y="903.0" width="236.0" height="46.0" as="geometry"/></mxCell><mxCell id="v23" value="Нажать «Печать отчета» или «Начать новую смену»" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="47.0" y="977.0" width="236.0" height="46.0" as="geometry"/></mxCell><mxCell id="v24" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="151.0" y="1060.0" width="28.0" height="28.0" as="geometry"/></mxCell><mxCell id="e25" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=open;endFill=0;endSize=8;strokeColor=#000000;fontSize=11;fontFamily=Helvetica;exitX=0.5;exitY=1.0;exitDx=0;exitDy=0;entryX=0.5;entryY=0.0;entryDx=0;entryDy=0;" edge="1" parent="1" source="v9" target="v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e26" value="" style="edgeStyle=none;rounded=0;html=1;endArrow=open;endFill=0;endSize=8;strokeColor=#000000;fontSize=11;f