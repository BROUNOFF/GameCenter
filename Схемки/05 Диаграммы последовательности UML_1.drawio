etPoint"/><Array as="points"><mxPoint x="356.5" y="171.0"/><mxPoint x="356.5" y="211.0"/></Array></mxGeometry></mxCell><mxCell id="v32" value="2. Создать сделку, запустить робот «Исходящий вебхук»" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="362.5" y="165.0" width="150.0" height="38.0" as="geometry"/></mxCell><mxCell id="e33" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;strokeWidth=1.2;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="322.5" y="277.0" as="sourcePoint"/><mxPoint x="522.5" y="277.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v34" value="3. POST /hs/bitrix/booking {deal_id, phone, name, hall, start, minutes, token}" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="328.5" y="226.0" width="188.0" height="47.0" as="geometry"/></mxCell><mxCell id="e35" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;strokeWidth=1.2;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="522.5" y="326.0" as="sourcePoint"/><mxPoint x="722.5" y="326.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v36" value="4. ОбработатьЗаявку(ТелоJSON, Токен)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="528.5" y="290.0" width="188.0" height="32.0" as="geometry"/></mxCell><mxCell id="e37" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;strokeWidth=1.2;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="722.5" y="348.0" as="sourcePoint"/><mxPoint x="728.5" y="403.0" as="targetPoint"/><Array as="points"><mxPoint x="756.5" y="348.0"/><mxPoint x="756.5" y="403.0"/></Array></mxGeometry></mxCell><mxCell id="v38" value="5. ПроверитьТокен (SHA-256), РазобратьПакет (ЧтениеJSON)" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="762.5" y="342.0" width="150.0" height="53.0" as="geometry"/></mxCell><mxCell id="e39" value="" style="edgeStyle=none;html=1;endArrow=open;endFill=0;endSize=9;dashed=1;dashPattern=6 4;strokeColor=#000000;strokeWidth=1.2;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="722.5" y="485.0" as="sourcePoint"/><mxPoint x="522.5" y="485.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v40" value="6. Ошибка проверки" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="528.5" y="464.0" width="188.0" height="17.0" as="geometry"/></mxCell><mxCell id="e41" value="" style="edgeStyle=none;html=1;endArrow=open;endFill=0;endSize=9;dashed=1;dashPattern=6 4;strokeColor=#000000;strokeWidth=1.2;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="522.5" y="534.0" as="sourcePoint"/><mxPoint x="322.5" y="534.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v42" value="7. 401 Unauthorized или 400 Bad Request" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="328.5" y="498.0" width="188.0" height="32.0" as="geometry"/></mxCell><mxCell id="e43" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;strokeWidth=1.2;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="722.5" y="610.0" as="sourcePoint"/><mxPoint x="1122.5" y="610.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v44" value="8. Найти бронь по ИДСделкиБитрикс24, клиента по телефону" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="728.5" y="589.0" width="388.0" height="17.0" as="geometry"/></mxCell><mxCell id="e45" value="" style="edgeStyle=none;html=1;endArrow=open;endFill=0;endSize=9;dashed=1;dashPattern=6 4;strokeColor=#000000;strokeWidth=1.2;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1122.5" y="644.0" as="sourcePoint"/><mxPoint x="722.5" y="644.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v46" value="9. Брони нет; клиент найден или нет" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="728.5" y="623.0" width="388.0" height="17.0" as="geometry"/></mxCell><mxCell id="e47" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;strokeWidth=1.2;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="722.5" y="693.0" as="sourcePoint"/><mxPoint x="922.5" y="693.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v48" value="10. СоздатьИзЗаявки(Данные): клиент, бронь «Новая»" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="728.5" y="657.0" width="188.0" height="32.0" as="geometry"/></mxCell><mxCell id="e49" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;strokeWidth=1.2;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="922.5" y="757.0" as="sourcePoint"/><mxPoint x="1122.5" y="757.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v50" value="11. Транзакция: блокировка ГрафикЗанятости по залу, запрос пересечений" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="928.5" y="706.0" width="188.0" height="47.0" as="geometry"/></mxCell><mxCell id="e51" value="" style="edgeStyle=none;html=1;endArrow=open;endFill=0;endSize=9;dashed=1;dashPattern=6 4;strokeColor=#000000;strokeWidth=1.2;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1122.5" y="806.0" as="sourcePoint"/><mxPoint x="922.5" y="806.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v52" value="12. Свободные ПК зала на интервал" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="928.5" y="770.0" width="188.0" height="32.0" as="geometry"/></mxCell><mxCell id="e53" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;strokeWidth=1.2;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="922.5" y="916.0" as="sourcePoint"/><mxPoint x="1122.5" y="916.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v54" value="13. Провести бронь «Подтверждена» с ПК, движения ГрафикЗанятости, сообщение в очередь" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="928.5" y="865.0" width="188.0" height="47.0" as="geometry"/></mxCell><mxCell id="e55" value="" style="edgeStyle=none;html=1;endArrow=open;endFill=0;endSize=9;dashed=1;dashPattern=6 4;strokeColor=#000000;strokeWidth=1.2;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="922.5" y="950.0" as="sourcePoint"/><mxPoint x="722.5" y="950.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v56" value="14. Бронь подтверждена" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="728.5" y="929.0" width="188.0" height="17.0" as="geometry"/></mxCell><mxCell id="e57" value="" style="edgeStyle=none;html=1;endArrow=open;endFill=0;endSize=9;dashed=1;dashPattern=6 4;strokeColor=#000000;strokeWidth=1.2;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="722.5" y="999.0" as="sourcePoint"/><mxPoint x="522.5" y="999.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v58" value="15. Результат: confirmed, номер ПК" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="528.5" y="963.0" width="188.0" height="32.0" as="geometry"/></mxCell><mxCell id="e59" value="" style="edgeStyle=none;html=1;endArrow=open;endFill=0;endSize=9;dashed=1;dashPattern=6 4;strokeColor=#000000;strokeWidth=1.2;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="522.5" y="1033.0" as="sourcePoint"/><mxPoint x="322.5" y="1033.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v60" value="16. 201 {status: confirmed, pc}" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="328.5" y="1012.0" width="188.0" height="17.0" as="geometry"/></mxCell><mxCell id="e61" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;strokeWidth=1.2;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="922.5" y="1124.0" as="sourcePoint"/><mxPoint x="1122.5" y="1124.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v62" value="17. Статус «Отказ», событие в журнал, сообщение в очередь" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="928.5" y="1088.0" width="188.0" height="32.0" as="geometry"/></mxCell><mxCell id="e63" value="" style="edgeStyle=none;html=1;endArrow=open;endFill=0;endSize=9;dashed=1;dashPattern=6 4;strokeColor=#000000;strokeWidth=1.2;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="922.5" y="1158.0" as="sourcePoint"/><mxPoint x="722.5" y="1158.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v64" value="18. Отказ: нет мест" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="728.5" y="1137.0" width="188.0" height="17.0" as="geometry"/></mxCell><mxCell id="e65" value="" style="edgeStyle=none;html=1;endArrow=open;endFill=0;endSize=9;dashed=1;dashPattern=6 4;strokeColor=#000000;strokeWidth=1.2;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="722.5" y="1192.0" as="sourcePoint"/><mxPoint x="522.5" y="1192.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v66" value="19. Результат: rejected" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="528.5" y="1171.0" width="188.0" height="17.0" as="geometry"/></mxCell><mxCell id="e67" value="" style="edgeStyle=none;html=1;endArrow=open;endFill=0;endSize=9;dashed=1;dashPattern=6 4;strokeColor=#000000;strokeWidth=1.2;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="522.5" y="1241.0" as="sourcePoint"/><mxPoint x="322.5" y="1241.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v68" value="20. 409 {status: rejected, reason: no_free_pc}" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="328.5" y="1205.0" width="188.0" height="32.0" as="geometry"/></mxCell><mxCell id="e69" value="" style="edgeStyle=none;html=1;endArrow=open;endFill=0;endSize=9;strokeColor=#000000;strokeWidth=1.2;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="722.5" y="1312.0" as="sourcePoint"/><mxPoint x="322.5" y="1312.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v70" value="21. Фоновое задание: crm.deal.update — стадия «Подтверждено» или «Отказ: нет мест»" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="328.5" y="1276.0" width="388.0" height="32.0" as="geometry"/></mxCell><mxCell id="e71" value="" style="edgeStyle=none;html=1;endArrow=open;endFill=0;endSize=9;dashed=1;dashPattern=6 4;strokeColor=#000000;strokeWidth=1.2;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="322.5" y="1346.0" as="sourcePoint"/><mxPoint x="722.5" y="1346.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v72" value="22. result: true, сообщение очереди «Отправлено»" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="328.5" y="1325.0" width="388.0" height="17.0" as="geometry"/></mxCell><mxCell id="e73" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;strokeWidth=1.2;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="722.5" y="1436.0" as="sourcePoint"/><mxPoint x="728.5" y="1491.0" as="targetPoint"/><Array as="points"><mxPoint x="756.5" y="1436.0"/><mxPoint x="756.5" y="1491.0"/></Array></mxGeometry></mxCell><mxCell id="v74" value="23. Регламентное задание каждые 60 с повторяет отправку, не более 5 попыток" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="762.5" y="1430.0" width="150.0" height="53.0" as="geometry"/></mxCell><mxCell id="e75" value="" style="edgeStyle=none;html=1;endArrow=open;endFill=0;endSize=9;strokeColor=#000000;strokeWidth=1.2;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="322.5" y="1564.0" as="sourcePoint"/><mxPoint x="122.5" y="1564.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v76" value="24. Уведомление клиенту о брони или отказе" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="128.5" y="1528.0" width="188.0" height="32.0" as="geometry"/></mxCell><mxCell id="e77" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;strokeWidth=1.2;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1322.5" y="1613.0" as="sourcePoint"/><mxPoint x="1122.5" y="1613.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v78" value="25. Обработчик ожидания (30 с): новые брони и события журнала" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1128.5" y="1577.0" width="188.0" height="32.0" as="geometry"/></mxCell><mxCell id="e79" value="" style="edgeStyle=none;html=1;endArrow=open;endFill=0;endSize=9;dashed=1;dashPattern=6 4;strokeColor=#000000;strokeWidth=1.2;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1122.5" y="1662.0" as="sourcePoint"/><mxPoint x="1322.5" y="1662.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v80" value="26. Новая 