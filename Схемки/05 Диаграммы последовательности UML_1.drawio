ьный признак" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="343.5" y="1201.0" width="1063.0" height="17.0" as="geometry"/></mxCell><mxCell id="e65" value="" style="edgeStyle=none;html=1;endArrow=open;endFill=0;endSize=9;dashed=1;dashPattern=6 4;strokeColor=#000000;strokeWidth=1.2;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="337.5" y="1271.0" as="sourcePoint"/><mxPoint x="122.5" y="1271.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v66" value="22. Документ проведён, сумма сдачи" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="128.5" y="1235.0" width="203.0" height="32.0" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="seq-4" name="UC-04 — Регистрация нового клиента и назначение программы лояльности"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1495" pageHeight="1084" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="v1" value="Клиент" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#FFFFFF;strokeColor=#000000;fontSize=12;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="107.5" y="18.0" width="30.0" height="52.0" as="geometry"/></mxCell><mxCell id="e2" value="" style="endArrow=none;dashed=1;dashPattern=6 4;strokeColor=#555555;strokeWidth=1;html=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="122.5" y="96.0" as="sourcePoint"/><mxPoint x="122.5" y="1074.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v3" value="Администратор" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;f