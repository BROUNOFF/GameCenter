etry"><mxPoint x="1072.5" y="315.0" as="sourcePoint"/><mxPoint x="692.5" y="315.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v32" value="5. Статус «Свободен», ближайшая бронь" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="698.5" y="294.0" width="368.0" height="17.0" as="geometry"/></mxCell><mxCell id="e33" value="" style="edgeStyle=none;html=1;endArrow=open;endFill=0;endSize=9;dashed=1;dashPattern=6 4;strokeColor=#000000;strokeWidth=1.2;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="692.5" y="364.0" as="sourcePoint"/><mxPoint x="502.5" y="364.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v34" value="6. ПК доступен, допустимый интервал" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="508.5" y="328.0" width="178.0" height="32.0" as="geometry"/></mxCell><mxCell id="e35" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;strokeWidth=1.2;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="122.5" y="398.0" as="sourcePoint"/><mxPoint x="502.5" y="398.0" as="targetPoint"/></mxGeometry></mxCell><mxCell id="v36" value="7. Телефон клиента или «Гость», тариф, длительность" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=bottom;fontSize=11;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="128.5" y="377.0" width="368.0" height="17.0" as="geometry"/></mxCell><mxCell id="e37" value="" style="edgeStyle=none;html=1;endArrow=block;endFill=1;endSize=8;strokeColor=#000000;strokeWidth=1.2;fontFamily=Helvetica;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="502.5" y="432.0" as="sourcePoint"/><mxPoint x="882.5" y="4